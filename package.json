{
  "name": "privacy-notice-gen",
  "version": "2.0.0",
  "description": "Convert Word documents (.docx) to styled, accessible HTML fragments for Umbraco RTE with BEM conventions",
  "main": "dist/index.js",
  "bin": {
    "privacy-notice-gen": "./dist/cli/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "docx",
    "html",
    "converter",
    "accessibility",
    "wcag",
    "bem",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "mammoth": "^1.8.0",
    "js-yaml": "^4.1.0",
    "yargs": "^17.7.0",
    "chalk": "^5.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/js-yaml": "^4.0.9",
    "@types/yargs": "^17.0.32",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "vitest": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0",
    "@axe-core/cli": "^4.8.0",
    "playwright": "^1.40.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "prettier": "^3.1.1"
  }
}
